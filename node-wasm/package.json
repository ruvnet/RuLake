{
  "name": "rulake-wasm",
  "version": "2.2.1",
  "description": "Memory Lake for Agentic AI — WASM build for browsers, Cloudflare Workers, Deno, Bun. Same witness-anchored memory model as `rulake` (Node.js bindings), feature-reduced surface for edge runtimes (no AVX-512, no rayon).",
  "type": "module",
  "main": "rulake_wasm.js",
  "module": "rulake_wasm.js",
  "types": "rulake_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./rulake_wasm.d.ts",
      "browser": "./web/rulake_wasm.js",
      "worker": "./web/rulake_wasm.js",
      "deno": "./rulake_wasm.js",
      "bun": "./rulake_wasm.js",
      "import": "./rulake_wasm.js",
      "require": "./nodejs/rulake_wasm.js",
      "default": "./rulake_wasm.js"
    },
    "./web": {
      "types": "./web/rulake_wasm.d.ts",
      "default": "./web/rulake_wasm.js"
    },
    "./nodejs": {
      "types": "./nodejs/rulake_wasm.d.ts",
      "default": "./nodejs/rulake_wasm.js"
    }
  },
  "files": [
    "rulake_wasm.js",
    "rulake_wasm.d.ts",
    "rulake_wasm_bg.js",
    "rulake_wasm_bg.wasm",
    "rulake_wasm_bg.wasm.d.ts",
    "web/",
    "nodejs/",
    "README.md"
  ],
  "keywords": [
    "ai", "agent", "agentic", "agent-memory",
    "llm", "rag", "vector", "vector-search", "semantic-search",
    "embedding", "embedding-cache", "ann", "rabitq",
    "wasm", "webassembly", "browser",
    "cloudflare-workers", "deno", "bun", "edge",
    "mcp", "model-context-protocol",
    "provenance", "witness", "rulake"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/RuLake.git",
    "directory": "node-wasm"
  },
  "homepage": "https://github.com/ruvnet/RuLake#wasm",
  "bugs": "https://github.com/ruvnet/RuLake/issues",
  "license": "MIT OR Apache-2.0",
  "author": "Ruvector Team",
  "engines": {
    "node": ">=18"
  }
}
