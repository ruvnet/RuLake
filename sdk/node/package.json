{
  "name": "rulake",
  "version": "2.3.0-alpha.1",
  "description": "Memory Lake for Agentic AI — fast, witness-anchored vector memory for LLM agents. Cache layer for RAG, semantic search, federated retrieval over S3/BigQuery/Parquet, MCP-compatible. Node.js bindings.",
  "type": "module",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./http": {
      "types": "./http.d.ts",
      "import": "./http.mjs",
      "default": "./http.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "http.mjs",
    "http.d.ts",
    "binding.cjs",
    "rulake.linux-x64-gnu.node",
    "rulake.linux-arm64-gnu.node",
    "rulake.darwin-x64.node",
    "rulake.darwin-arm64.node",
    "rulake.win32-x64-msvc.node"
  ],
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Ruvector Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/RuLake"
  },
  "keywords": [
    "ai",
    "agent",
    "agentic",
    "agent-memory",
    "llm",
    "rag",
    "retrieval-augmented-generation",
    "vector",
    "vector-search",
    "vector-database",
    "semantic-search",
    "embedding",
    "embeddings",
    "embedding-cache",
    "ann",
    "approximate-nearest-neighbor",
    "rabitq",
    "quantization",
    "cache",
    "memory",
    "datalake",
    "lakehouse",
    "federation",
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "openai",
    "langchain",
    "llamaindex",
    "provenance",
    "witness",
    "edge-ai",
    "rust",
    "napi",
    "napi-rs",
    "ruvector"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/*.test.mjs",
    "prepublishOnly": "node -e \"if (!require('fs').existsSync('../../vendor/ruvector/Cargo.toml')) { console.error('vendor/ruvector submodule missing — run git submodule update --init --recursive (ADR-001)'); process.exit(1); }\""
  },
  "napi": {
    "name": "rulake",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "optionalDependencies": {
    "rulake-linux-x64-gnu": "2.3.0-alpha.1",
    "rulake-linux-arm64-gnu": "2.3.0-alpha.1",
    "rulake-darwin-x64": "2.3.0-alpha.1",
    "rulake-darwin-arm64": "2.3.0-alpha.1",
    "rulake-win32-x64-msvc": "2.3.0-alpha.1",
    "rulake-wasm": "2.3.0-alpha.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
