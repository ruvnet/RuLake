{
  "name": "rulake-bundle-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP publisher for ruLake bundle sidecars: watches a directory tree, exposes table.rulake.json + witness over GET, ETags by witness.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "chokidar": "^3.6.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
