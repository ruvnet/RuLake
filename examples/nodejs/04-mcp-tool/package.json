{
  "name": "rulake-mcp-tool",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that exposes a ruLake snapshot as agent-callable tools (search, witness verification, bundle info).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**' --exclude '**/node_modules/**'",
    "test:watch": "vitest --exclude '**/dist/**' --exclude '**/node_modules/**'",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
